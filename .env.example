# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Dashboard → Project Settings → API). Essas duas chaves são públicas por
# design (protegidas pelas policies de RLS) — não coloque a service role key
# aqui nem em nenhum lugar do app.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
